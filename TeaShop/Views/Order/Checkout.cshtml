@model TeaShop.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="checkout-page">
    <h2>Checkout</h2>

    <div class="checkout-card">
        <div class="checkout-total">
            Order Total: €@Model.Total.ToString("F2")
            <br/>
            <small class="checkout-subtitle">
                @Model.CartItems.Count item(s)
            </small>
        </div>

        <table class="cart-table checkout-review-table">
            <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Subtotal</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.CartItems)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Quantity</td>
                    <td>€@item.Subtotal.ToString("F2")</td>
                </tr>
            }
            </tbody>
        </table>

        <h3 class="section-heading">Shipping Address</h3>

        <div asp-validation-summary="ModelOnly"></div>

        <form asp-action="Checkout" method="post">
            <div class="form-group">
                <label asp-for="ShippingAddress"></label>
                <input asp-for="ShippingAddress" placeholder="123 Main Street"/>
                <span asp-validation-for="ShippingAddress"></span>
            </div>

            <div class="form-group">
                <label asp-for="ShippingCity"></label>
                <input asp-for="ShippingCity" placeholder="Sofia"/>
                <span asp-validation-for="ShippingCity"></span>
            </div>

            <div class="form-group">
                <label asp-for="ShippingPostalCode"></label>
                <input asp-for="ShippingPostalCode" placeholder="1000"/>
                <span asp-validation-for="ShippingPostalCode"></span>
            </div>

            <h3 class="section-heading">Payment</h3>
            <div class="form-group payment-options">
                <label class="radio-label">
                    <input type="radio" name="PaymentMethod" value="PayNow" checked/>
                    Pay Now
                </label>
                <label class="radio-label">
                    <input type="radio" name="PaymentMethod" value="PayLater"/>
                    Pay Later
                </label>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">
                Place Order
            </button>
        </form>

        <div class="back-link">
            <a asp-controller="Cart" asp-action="Index">Back to Cart...</a>
        </div>
    </div>
</div>



