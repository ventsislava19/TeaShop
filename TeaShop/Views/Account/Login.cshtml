@model TeaShop.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-card">
        <h2>Login</h2>

        <div asp-validation-summary="All"></div>

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" placeholder="your@email.com"/>
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" placeholder="Your password"/>
                <span asp-validation-for="Password"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">Login</button>
        </form>

        <p class="auth-link">
            Don't have an account? <a asp-action="Register">Register here!</a>
        </p>
    </div>
</div>



