@model List<TeaShop.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="cart-page">
    <h2>Shopping Cart</h2>

    @if (Model.Any())
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                        </td>
                        <td>€@item.Price.ToString("F2")</td>
                        <td>
                            <form asp-controller="Cart" asp-action="Update" method="post"
                                  class="cart-quantity-form">
                                <input type="hidden" name="productId" value="@item.ProductId"/>
                                <input type="number" name="quantity" value="@item.Quantity"
                                       min="1" max="99" onchange="this.form.submit()"/>
                            </form>
                        </td>
                        <td><strong>€@item.Subtotal.ToString("F2")</strong></td>
                        <td style="text-align: center;">
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId"/>
                                <button type="submit" class="btn btn-secondary btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="cart-summary">
            <span class="cart-total">
                Total: €@Model.Sum(i => i.Subtotal).ToString("F2")
            </span>
            <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary">
                Proceed to Checkout
            </a>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <p>Your cart is empty.</p>
            <p><a asp-controller="Home" asp-action="Index">Browse our teas...</a></p>
        </div>
    }
</div>