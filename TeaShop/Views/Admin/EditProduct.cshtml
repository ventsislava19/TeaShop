@model TeaShop.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="auth-page-wide">
    <div class="auth-card">
        <h2>Edit Product</h2>

        <div asp-validation-summary="All"></div>

        <form asp-action="EditProduct" method="post">
            <input type="hidden" asp-for="Id"/>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name"/>
                <span asp-validation-for="Name"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="3" class="form-textarea"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Price"></label>
                <input asp-for="Price" type="number" step="0.01"/>
                <span asp-validation-for="Price"></span>
            </div>

            <div class="form-group">
                <label asp-for="Image"></label>
                <input asp-for="Image" placeholder="filename.jpg"/>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId"></label>
                <select asp-for="CategoryId" asp-items="@ViewBag.Categories">
                </select>
            </div>

            <div class="form-group">
                <label asp-for="OriginCountry"></label>
                <input asp-for="OriginCountry" placeholder="e.g. Japan, China, India"/>
                <span asp-validation-for="OriginCountry"></span>
            </div>

            <div class="form-group">
                <label asp-for="Stock"></label>
                <input asp-for="Stock" type="number" min="0"/>
                <span asp-validation-for="Stock"></span>
            </div>

            <div class="form-group">
                <label asp-for="Caffeine"></label>
                <select asp-for="Caffeine" asp-items="Html.GetEnumSelectList<TeaShop.Models.CaffeineType>()">
                </select>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">Save Changes</button>
        </form>

        <div class="back-link">
            <a asp-action="Products">Back to Products</a>
        </div>
    </div>
</div>



